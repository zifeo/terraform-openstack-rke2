--- rke2-coredns/values.yaml
+++ rke2-coredns/values.patched.yaml
@@ -1,10 +1,10 @@
 resources:
   limits:
-    cpu: 100m
-    memory: 128Mi
+    cpu: "100m" # because of autoscaler
+    memory: "128Mi"
   requests:
-    cpu: 100m
-    memory: 128Mi
+    cpu: "100m"
+    memory: "128Mi"
 autoscaler:
   # Enabled the cluster-proportional-autoscaler
   enabled: true
@@ -13,13 +13,13 @@
   # Number of nodes in the cluster per coredns replica
   nodesPerReplica: 16
   # Min size of replicaCount
-  min: 0
+  min: <value:int>
   # Max size of replicaCount (default of 0 is no max)
   max: 0
   # Whether to include unschedulable nodes in the nodes/cores calculations - this requires version 1.8.0+ of the autoscaler
   includeUnschedulableNodes: false
-  # If true does not allow single points of failure to form
-  preventSinglePointFailure: true
+  # its two replicas from two nodes on would leave one Pending on a single agent: min decides
+  preventSinglePointFailure: false
   # Annotations for the coredns proportional autoscaler pods
   podAnnotations: {}
   # When true, top-level customLabels are also applied to the autoscaler Deployment/pods.
@@ -94,14 +94,9 @@
   # - name: some-container-name
   #   image: some-image:latest
   #   imagePullPolicy: Always
-tolerations:
-  - key: "node-role.kubernetes.io/control-plane"
-    operator: "Exists"
-    effect: "NoSchedule"
-  - key: "node-role.kubernetes.io/etcd"
-    operator: "Exists"
-    effect: "NoExecute"
+tolerations: []
 rollingUpdate:
   maxUnavailable: 1
-  maxSurge: 25%
-podDisruptionBudget: {}
+  maxSurge: 0
+podDisruptionBudget:
+  maxUnavailable: 1
